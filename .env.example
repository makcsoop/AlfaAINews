# Скопируй в .env и заполни. Секреты в репозиторий не коммитим.

# PostgreSQL (pgvector)
POSTGRES_USER=newsai
POSTGRES_PASSWORD=newsai
POSTGRES_DB=newsai
# DATABASE_URL не задаём: в контейнерах его ставит docker-compose (db:5432),
# с хоста по умолчанию localhost:${DB_HOST_PORT}
DB_HOST_PORT=55432

# Redis
# REDIS_URL в контейнерах ставит docker-compose

# LLM: общий ключ организаторов, OpenAI-совместимый API (клиент пишет Разработчик 3).
# Ключ (sk-…) только в .env, никогда в репозиторий, чаты и браузерный код.
# Лимит 500 ₽/день на ключ, общий для команды и всех моделей; сброс в 3:00 МСК.
# Ошибка «Budget has been exceeded» = лимит исчерпан. На разработку по плану ≤ 300 ₽/день.
LLM_API_BASE=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_DAILY_BUDGET_RUB=300
# Точные имена разрешённых моделей:
LLM_MODEL_EXTRACT=google/gemma-4-26b-a4b-it
LLM_MODEL_REASONING=z-ai/glm-5.3-flash
LLM_MODEL_GENERAL=qwen/qwen3.6-35b-a3b
LLM_MODEL_QA=deepseek/deepseek-v4.1-flash
LLM_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct
LLM_MODEL_OFFLINE=moonshotai/kimi-k2.6

# Telegram (Telethon, день 2). Сессия — только через переменные/секреты
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# Сбор
INGEST_USER_AGENT=AlfaAINews-hackathon-bot/0.1 (+https://github.com/makcsoop/AlfaAINews)
INGEST_HOST_RPS=1
SOURCES_CONFIG=config/sources.yaml

# Путь к CSV кейса внутри контейнера
CASE_DATA_DIR=data/case
