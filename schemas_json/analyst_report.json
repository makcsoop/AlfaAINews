{
  "$defs": {
    "ChannelImpact": {
      "additionalProperties": false,
      "description": "Как событие двигает фактор: «ставка выше», «рубль крепче». Это направление фактора,\nа не «хорошо / плохо» (У17): знак для клиента получается только умножением на его\nчувствительность к фактору (ChannelExposure.sensitivity).",
      "properties": {
        "channel": {
          "description": "id фактора из config/channels_matrix.yaml",
          "title": "Channel",
          "type": "string"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ],
          "title": "Direction",
          "type": "string"
        },
        "strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "horizon": {
          "anyOf": [
            {
              "enum": [
                "days",
                "weeks",
                "months",
                "quarters",
                "years"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "channel",
        "direction",
        "strength"
      ],
      "title": "ChannelImpact",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Ссылка на фрагмент первоисточника. quote — дословная цитата, span — позиции в тексте.",
      "properties": {
        "source_id": {
          "description": "raw_item id, bank chunk id 'doc#p3#c2' или 'csv:FIELD'",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doc_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Date"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "цитата найдена в тексте (rapidfuzz ≥ 90)",
          "title": "Verified"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "9. Отчёт независимого аналитика (бизнес / финансы) по паре «сюжет × отрасль».",
  "properties": {
    "story_id": {
      "title": "Story Id",
      "type": "string"
    },
    "sector": {
      "title": "Sector",
      "type": "string"
    },
    "analyst": {
      "enum": [
        "business",
        "finance"
      ],
      "title": "Analyst",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelImpact"
      },
      "title": "Channels",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    }
  },
  "required": [
    "story_id",
    "sector",
    "analyst",
    "model",
    "channels",
    "summary"
  ],
  "title": "AnalystReport",
  "type": "object",
  "$comment": "schema 0.2.0"
}