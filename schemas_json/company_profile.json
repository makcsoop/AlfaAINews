{
  "$defs": {
    "ChannelExposure": {
      "additionalProperties": false,
      "description": "Чувствительность компании к каналу со знаком и причиной (поле CSV или контрагенты).",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "sensitivity": {
          "description": "что получает клиент, когда фактор растёт: + выигрывает, − проигрывает; модуль — сила",
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Sensitivity",
          "type": "number"
        },
        "drivers": {
          "description": "'CL_PRODUCT_LOA_MARK=1', 'payments: 35% исходящих → ОКВЭД 24'",
          "items": {
            "type": "string"
          },
          "title": "Drivers",
          "type": "array"
        },
        "is_assumption": {
          "default": false,
          "description": "предположение AI (например, импорт/экспорт по ОКВЭД)",
          "title": "Is Assumption",
          "type": "boolean"
        }
      },
      "required": [
        "channel",
        "sensitivity",
        "drivers"
      ],
      "title": "ChannelExposure",
      "type": "object"
    }
  },
